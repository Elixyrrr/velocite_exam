                            "source": {
                                "type": "AzureSqlSource",
                                "sqlReaderQuery": {
                                    "value": "@concat('SELECT * FROM dbo.locations WHERE modifie_le > DATEADD(DAY, -7, CAST(''', activity('LKP_WM_LOCATIONS').output.firstRow.last_value, ''' AS DATETIME2)) AND modifie_le <= CAST(''', formatDateTime(pipeline().TriggerTime, 'yyyy-MM-ddTHH:mm:ss'), ''' AS DATETIME2)')",
