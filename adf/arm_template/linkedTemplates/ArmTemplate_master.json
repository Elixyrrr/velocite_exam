{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Data Factory name",
            "defaultValue": "adf-velocite-dev"
        },
        "LS_AzureSQL_VeloCite_properties_typeProperties_server": {
            "type": "string",
            "defaultValue": "sql-velocite.database.windows.net"
        },
        "LS_AzureSQL_VeloCite_properties_typeProperties_database": {
            "type": "string",
            "defaultValue": "sqldb-velocite"
        },
        "LS_ADLS_VeloCite_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://ilyestristanflo2.dfs.core.windows.net/"
        },
        "containerUri": {
            "type": "string",
            "metadata": "URI to storage account containing linked ARM templates"
        },
        "containerSasToken": {
            "type": "string",
            "metadata": "Sas token to storage account containing linked ARM templates"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "adf-velocite-dev_ArmTemplate_0",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2024-03-01",
            "properties": {
                "mode": "incremental",
                "templateLink": {
                    "uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "factoryName": {
                        "value": "[parameters('factoryName')]"
                    },
                    "LS_AzureSQL_VeloCite_properties_typeProperties_server": {
                        "value": "[parameters('LS_AzureSQL_VeloCite_properties_typeProperties_server')]"
                    },
                    "LS_AzureSQL_VeloCite_properties_typeProperties_database": {
                        "value": "[parameters('LS_AzureSQL_VeloCite_properties_typeProperties_database')]"
                    },
                    "LS_ADLS_VeloCite_properties_typeProperties_url": {
                        "value": "[parameters('LS_ADLS_VeloCite_properties_typeProperties_url')]"
                    }
                }
            },
            "dependsOn": []
        }
    ]
}